# Tauri runtime env (loaded by the installed app at runtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Vite build-managed env (embedded into the frontend at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub App Device Flow (public client identifier only; no secret/private key)
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
